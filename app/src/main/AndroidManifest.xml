<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app is 100% offline: no network access at all, even if a library asks for it.
         (ACCESS_NETWORK_STATE comes from WorkManager and only reads connectivity state.) -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <!-- Runtime-requested on API 33+ only when the user opts into the streak reminder in Settings
         (see StreakReminderNotifications) - not requested at first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".QwApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.QuranicWords">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.QuranicWords.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager auto-initializes via this provider by default, which conflicts with
             QwApplication's own Configuration.Provider (needed for Hilt-injected Workers) -
             disabling the default initializer so our manual configuration is the only one. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Widget Providers -->
        <receiver
            android:name=".feature.widget.StatsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>

        <receiver
            android:name=".feature.widget.WordWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_word_info" />
        </receiver>

        <receiver
            android:name=".feature.widget.CombinedWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combined_info" />
        </receiver>

        <!-- Widget Background Receivers -->
        <receiver
            android:name=".feature.widget.WidgetAlarmReceiver"
            android:exported="false" />

        <!-- "Next word" / "reveal meaning" taps - explicit PendingIntents from our own widgets only. -->
        <receiver
            android:name=".feature.widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- Day rollover, clock/timezone and language changes, and app updates: refresh widgets so
             the streak, today's goal and strings are right. All are system-protected broadcasts;
             DATE_CHANGED only reaches manifest receivers before API 26, where the midnight alarm
             in WidgetUpdateScheduler covers it. -->
        <receiver
            android:name=".feature.widget.WidgetSystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>