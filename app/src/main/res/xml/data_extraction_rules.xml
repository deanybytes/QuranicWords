<?xml version="1.0" encoding="utf-8"?>
<!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes for details.

   Mirrors backup_rules.xml's exclusions for Android 12+'s cloud-backup/device-transfer split -
   see that file's comment for why.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="uhq.db" />
        <exclude domain="database" path="uhq.db-wal" />
        <exclude domain="database" path="uhq.db-shm" />
        <exclude domain="database" path="uhq.db-journal" />
        <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="uhq.db" />
        <exclude domain="database" path="uhq.db-wal" />
        <exclude domain="database" path="uhq.db-shm" />
        <exclude domain="database" path="uhq.db-journal" />
        <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
