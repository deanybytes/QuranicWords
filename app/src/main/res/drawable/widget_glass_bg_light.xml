<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#1A000000" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="135"
                android:endColor="@color/widget_light_bg_gradient_end"
                android:startColor="@color/widget_light_bg_gradient_start"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="@color/widget_light_bg_stroke" />
        </shape>
    </item>
</layer-list>
