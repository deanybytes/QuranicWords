<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget palette (one green identity, WCAG AA text on every surface).
     wg_light_* / wg_dark_* are fixed and used when the in-app theme is forced Light or Dark;
     wg_* follow the launcher's night mode (values-night) for the System theme. -->
