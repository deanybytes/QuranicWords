<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base theme for the single Compose Activity - Compose (core/ui/theme/Theme.kt) owns all
         actual UI theming; this only needs to exist as a valid NoActionBar host theme. AppCompat
         (not Material Components) because MainActivity is an AppCompatActivity for per-app
         languages, and no View-based Material widgets are used. System bar colors are not set
         here: they are deprecated on Android 15+, and enableEdgeToEdge() in MainActivity draws
         the app behind transparent bars on every Android version. -->
    <style name="Theme.QuranicWords" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- Applied only until the first Compose frame is drawn (see MainActivity/installSplashScreen). -->
    <style name="Theme.QuranicWords.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_screen_background</item>
        <!-- ic_qw_mark.png is full-bleed (its gold ring is drawn right to the canvas edge), but
             the platform SplashScreen API expects an icon already inset to the adaptive-icon safe
             zone - it scales/masks on that assumption regardless of an icon background color, so
             the full-bleed mark got its outer ring cropped off entirely. ic_launcher_foreground
             is the same badge already padded to that safe zone (it's the adaptive launcher icon's
             foreground layer), so reuse it here instead of adding a new asset. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_screen_background</item>
        <item name="postSplashScreenTheme">@style/Theme.QuranicWords</item>
    </style>
</resources>
