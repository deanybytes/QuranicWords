<?xml version="1.0" encoding="utf-8"?>
<!-- Four-segment memory-strength meter, the same scale as the in-app WordStrengthMeter (New = no
     segment filled ... Mastered = all four). Segment images are swapped on/off from code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_meter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:ignore="UseCompoundDrawables">

    <ImageView
        android:id="@+id/iv_seg1"
        android:layout_width="14dp"
        android:layout_height="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_seg_on" />

    <ImageView
        android:id="@+id/iv_seg2"
        android:layout_width="14dp"
        android:layout_height="6dp"
        android:layout_marginStart="3dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_seg_on" />

    <ImageView
        android:id="@+id/iv_seg3"
        android:layout_width="14dp"
        android:layout_height="6dp"
        android:layout_marginStart="3dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_seg_off" />

    <ImageView
        android:id="@+id/iv_seg4"
        android:layout_width="14dp"
        android:layout_height="6dp"
        android:layout_marginStart="3dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_seg_off" />

    <TextView
        android:id="@+id/tv_strength"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:text="@string/word_strength_familiar"
        android:textColor="@color/wg_text_tertiary"
        android:textSize="11sp" />
</LinearLayout>
