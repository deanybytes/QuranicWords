<?xml version="1.0" encoding="utf-8"?>
<!-- Progress, medium (about 4x2 cells): goal ring beside streak, level, hearts, quests and the
     primary action. Also the API 31+ picker preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="12dp"
    tools:ignore="HardcodedText,UseAppTint,UseCompoundDrawables,NestedWeights,DisableBaselineAlignment">

    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/fl_goal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.38">

            <ImageView
                android:id="@+id/iv_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ring_preview" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_goal_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="7"
                    android:textColor="@color/wg_text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_goal_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_daily_goal_label"
                    android:textColor="@color/wg_text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="0.62"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_streak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_flame"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_flame"
                    android:tint="@color/wg_flame" />

                <TextView
                    android:id="@+id/tv_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="12"
                    android:textColor="@color/wg_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_streak_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_streak_label"
                    android:textColor="@color/wg_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/ll_hearts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_heart"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_heart"
                        android:tint="@color/wg_heart" />

                    <TextView
                        android:id="@+id/tv_hearts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="5"
                        android:textColor="@color/wg_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_level"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_level_word"
                    android:textColor="@color/wg_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_xp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:text="120 / 300 XP"
                    android:textColor="@color/wg_text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_xp_bar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_bar" />

            <LinearLayout
                android:id="@+id/ll_quests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_quests"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_check"
                    android:tint="@color/wg_accent" />

                <TextView
                    android:id="@+id/tv_quests"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_quests_title"
                    android:textColor="@color/wg_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/widget_cta"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="34dp"
                android:paddingHorizontal="12dp"
                android:text="@string/widget_review_now"
                android:textColor="@color/wg_cta_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_part_empty" />
</FrameLayout>
