<?xml version="1.0" encoding="utf-8"?>
<!-- Word of the Moment, one row tall: the word beside its meaning and status. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp"
    tools:ignore="HardcodedText,UseAppTint,UseCompoundDrawables,NestedWeights,DisableBaselineAlignment">

    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/fl_word"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42">

            <ImageView
                android:id="@+id/iv_arabic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:tint="@color/wg_text_primary"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tv_arabic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="28sp"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="كِتَٰب"
                android:textColor="@color/wg_text_primary"
                android:textDirection="rtl"
                android:textSize="24sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.58"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_meaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_preview_meaning"
                android:textColor="@color/wg_accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_reveal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_reveal"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:text="@string/widget_tap_to_reveal_short"
                android:textColor="@color/wg_accent"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_status_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_status_due"
                android:textColor="@color/wg_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_icon_btn"
            android:contentDescription="@string/widget_next_word"
            android:padding="5dp"
            android:src="@drawable/ic_widget_next"
            android:tint="@color/wg_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:text="@string/widget_not_ready_title"
            android:textColor="@color/wg_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_empty_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_cta"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="32dp"
            android:paddingHorizontal="14dp"
            android:text="@string/widget_open_app"
            android:textColor="@color/wg_cta_text"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
