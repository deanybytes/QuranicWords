<?xml version="1.0" encoding="utf-8"?>
<!-- Word & Progress, medium (about 4x2 cells): the word on one side, today's progress and the
     action on the other. Also the API 31+ picker preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="12dp"
    tools:ignore="HardcodedText,UseAppTint,UseCompoundDrawables,NestedWeights,DisableBaselineAlignment">

    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ll_word"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.56"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical|start"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/widget_chip_due"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="3dp"
                        android:text="@string/widget_status_due"
                        android:textColor="@color/wg_text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_next"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/widget_icon_btn"
                    android:contentDescription="@string/widget_next_word"
                    android:padding="6dp"
                    android:src="@drawable/ic_widget_next"
                    android:tint="@color/wg_text_primary" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/fl_word"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="32dp">

                <ImageView
                    android:id="@+id/iv_arabic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:tint="@color/wg_text_primary"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tv_arabic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autoSizeMaxTextSize="36sp"
                    android:autoSizeMinTextSize="16sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="كِتَٰب"
                    android:textColor="@color/wg_text_primary"
                    android:textDirection="rtl"
                    android:textSize="30sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_meaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/widget_preview_meaning"
                android:textColor="@color/wg_accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_reveal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/widget_reveal"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="28dp"
                android:paddingHorizontal="12dp"
                android:text="@string/widget_tap_to_reveal_short"
                android:textColor="@color/wg_accent"
                android:textSize="12sp"
                android:visibility="gone" />

            <include
                layout="@layout/widget_part_meter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_stats_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="0.44"
            android:background="@drawable/widget_card"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/ll_streak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_flame"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_flame"
                    android:tint="@color/wg_flame" />

                <TextView
                    android:id="@+id/tv_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="12"
                    android:textColor="@color/wg_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_streak_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_streak_label"
                    android:textColor="@color/wg_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_goal_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_daily_goal_label"
                android:textColor="@color/wg_text_secondary"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/iv_goal_bar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_bar" />

            <TextView
                android:id="@+id/tv_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_level_word"
                android:textColor="@color/wg_text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/widget_cta"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="32dp"
                android:paddingHorizontal="8dp"
                android:text="@string/widget_review_now"
                android:textColor="@color/wg_cta_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_part_empty" />
</FrameLayout>
