<?xml version="1.0" encoding="utf-8"?>
<!-- Friendly no-data state (first install, content still seeding): brand mark, two lines of copy
     and an obvious "Open app" action. Hidden until the binder needs it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher_round" />

    <TextView
        android:id="@+id/tv_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_not_ready_title"
        android:textColor="@color/wg_text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_empty_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:text="@string/widget_not_ready_desc"
        android:textColor="@color/wg_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_empty_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_cta"
        android:fontFamily="sans-serif-medium"
        android:minHeight="36dp"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:text="@string/widget_open_app"
        android:textColor="@color/wg_cta_text"
        android:textSize="13sp" />
</LinearLayout>
