# Deploy only what the static site needs: index.html, css/, js/, data/, icons/, favicon.png,
# manifest.json, sw.js, robots.txt, sitemap.xml, the Google verification file, and the word
# audio under app/src/main/assets/audio/ (referenced by data/index.json).

# Android app: everything except the audio directory
/app/*
!/app/src
/app/src/*
!/app/src/main
/app/src/main/*
!/app/src/main/assets
/app/src/main/assets/*
!/app/src/main/assets/audio

# Source fonts/images (the site uses subsets in css/fonts and icons/)
/assets/

# Tooling, sources and build outputs
/tools/
/db/
/reference/
/keys/
/corpus_data/
/docs/
/gradle/
/build/
/scripts/
/.github/
/reports/
