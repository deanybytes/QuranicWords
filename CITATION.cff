    title: "Quranic Arabic Corpus (morphology v0.4)"
    authors:
      - name: "Kais Dukes, University of Leeds"
    url: "https://corpus.quran.com"
  - type: data
    title: "Word-by-word Quran translations"
    authors:
      - name: "Greentech Apps Foundation"
    url: "https://quran.gtaf.org"
  - type: data
    title: "Tanzil Quran Text"
    authors:
